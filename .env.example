# For local development only. Production requires a real HTTPS origin.
# Copy extension settings to apps/extension/.env.local before building.
VITE_SIGNALING_URL=http://127.0.0.1:8787
VITE_STUN_URLS=stun:stun.l.google.com:19302

# Signaling server (export variables before npm run dev:server).
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/ghostpair.sqlite
# Read the exact extension ID in chrome://extensions or edge://extensions.
ALLOWED_ORIGINS=chrome-extension://replace_with_your_extension_id
