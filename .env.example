# Local development only. Production requires a real HTTPS origin.
# Copy to root .env; the server and extension builds load it automatically.
# Public VITE_* values enter the bundle. Never put secrets in them.
# Rebuild/reload after changes. Saved settings need "Use build defaults".
VITE_SIGNALING_URL=http://127.0.0.1:8787
VITE_STUN_URLS=stun:stun.l.google.com:19302

# Signaling server. Existing process environment variables take precedence.
HOST=127.0.0.1
PORT=8787
# Relative to the server working directory, not to this .env file.
DATABASE_PATH=./data/ghostpair.sqlite
# Any valid Chrome/Edge extension ID can connect. Web origins are denied.
# Optional for browser-page development fixtures only:
# DEV_ALLOW_LOCALHOST_ORIGINS=true
