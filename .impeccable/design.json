      "html": "<fieldset class=\"ds-switch\"><legend class=\"ds-hidden\">Choose an interface example</legend><div class=\"ds-option\"><input class=\"ds-hidden\" id=\"ds-shared\" type=\"radio\" name=\"ds-preview\" checked><label for=\"ds-shared\">Shared view</label></div><div class=\"ds-option\"><input class=\"ds-hidden\" id=\"ds-host\" type=\"radio\" name=\"ds-preview\"><label for=\"ds-host\">Host a session</label></div><div class=\"ds-option\"><input class=\"ds-hidden\" id=\"ds-guest\" type=\"radio\" name=\"ds-preview\"><label for=\"ds-guest\">Join a session</label></div></fieldset>",
      "css": ".ds-switch{display:flex;border:0;padding:4px;margin:0;background:var(--panel,#182321);border-radius:9px;font-family:\"Manrope Variable\",\"Segoe UI\",sans-serif}.ds-option{position:relative}.ds-hidden{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}.ds-option label{display:flex;align-items:center;justify-content:center;min-height:44px;padding:12px 22px;font-size:12px;font-weight:550;color:var(--muted,#a3b3ac);border-radius:6px;cursor:pointer;transition:color .3s,background .3s}.ds-option label:hover{color:var(--text,#eef3f1);background:var(--panel-light,#20302a)}.ds-option input:checked+label{background:var(--mint,#b5f0cd);color:var(--ink,#11261b)}.ds-option input:focus-visible+label{outline:2px solid var(--mint,#b5f0cd);outline-offset:6px}@media(max-width:360px){.ds-option label{font-size:9px;padding-inline:5px}}"
