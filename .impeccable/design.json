      "html": "<a class=\"ds-primary\" href=\"https://github.com/ThomasSerna/GhostPair/releases/latest\">Download GhostPair <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v12m-5-5 5 5 5-5M5 17v4h14v-4\"/></svg></a>",
      "css": ".ds-primary{display:inline-flex;justify-content:space-between;align-items:center;gap:34px;min-height:54px;border-radius:8px;padding:17px 22px;font-family:\"Manrope Variable\",\"Segoe UI\",sans-serif;font-size:13px;font-weight:650;text-decoration:none;transition:background .3s,transform .4s cubic-bezier(.16,1,.3,1);background:var(--mint,#b5f0cd);color:var(--ink,#11261b)}.ds-primary:hover{background:var(--mint-hover,#cef7df);transform:translateY(-2px)}.ds-primary:focus-visible{outline:2px solid var(--mint,#b5f0cd);outline-offset:5px}.ds-primary svg{width:17px;height:17px}@media(max-width:580px){.ds-primary{min-height:50px;padding:15px 18px;font-size:12px;gap:28px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:hover{transform:none}}"
