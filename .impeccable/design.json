    {
      "name": "Download action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary link to the real GitHub release.",
      "html": "<a class=\"ds-primary\" href=\"https://github.com/ThomasSerna/GhostPair/releases/latest\">Download GhostPair <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4v12m-5-5 5 5 5-5M5 19h14\"/></svg></a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:20px;padding:16px 22px;border-radius:9px;font-size:14px;line-height:1.4;font-weight:600;text-decoration:none;font-family:Inter,'Segoe UI',sans-serif;background:var(--mint,#b5f0cd);color:var(--ink,#11261b)}.ds-primary:hover{background:#cef7df;color:var(--ink,#11261b)}.ds-primary:focus-visible{outline:2px solid var(--mint,#b5f0cd);outline-offset:5px;}.ds-primary svg,.ds-install svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}@media(max-width:700px){.ds-primary{padding:15px 18px;font-size:13px;gap:16px}}"
    },
    {
      "name": "Installation action",
      "kind": "button",
      "refersTo": "button-install",
      "description": "Inverse action used on the mint installation field.",
      "html": "<a class=\"ds-install\" href=\"https://github.com/ThomasSerna/GhostPair/releases/latest\">Get the latest release <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4v12m-5-5 5 5 5-5M5 19h14\"/></svg></a>",
      "css": ".ds-install{display:inline-flex;align-items:center;justify-content:center;gap:20px;padding:16px 22px;border-radius:9px;font-size:14px;line-height:1.4;font-weight:600;text-decoration:none;font-family:Inter,'Segoe UI',sans-serif;background:var(--ink,#11261b);color:var(--mint,#b5f0cd)}.ds-install:hover{background:#244333;color:#eef3f1}.ds-install:focus-visible{outline:2px solid var(--ink,#11261b);outline-offset:5px}.ds-primary svg,.ds-install svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}@media(max-width:700px){.ds-install{padding:15px 18px;font-size:13px;gap:16px}}"
    },
    {
      "name": "Preview selector",
      "kind": "input",
      "refersTo": "preview-selector",
      "description": "Three native radio columns with a sliding mint indicator; CSS :has() also shows the corresponding panel.",
      "html": "<fieldset class=\"ds-selector\"><legend class=\"ds-hidden\">Choose an interface example</legend><input class=\"ds-hidden\" type=\"radio\" name=\"ds-preview\" id=\"ds-shared\" checked><label for=\"ds-shared\">Shared view</label><input class=\"ds-hidden\" type=\"radio\" name=\"ds-preview\" id=\"ds-host\"><label for=\"ds-host\">Host a session</label><input class=\"ds-hidden\" type=\"radio\" name=\"ds-preview\" id=\"ds-guest\"><label for=\"ds-guest\">Join a session</label></fieldset>",
      "css": ".ds-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}.ds-selector{--switch-gap:4px;font-family:Inter,'Segoe UI',sans-serif;display:grid;grid-template-columns:repeat(3,1fr);gap:var(--switch-gap);position:relative;margin:0;padding:5px;border:1px solid var(--line,#2b3935);border-radius:12px;background:var(--panel,#182321)}.ds-selector::before{content:'';position:absolute;top:5px;bottom:5px;left:5px;width:calc((100% - 10px - 2 * var(--switch-gap)) / 3);border-radius:8px;background:var(--mint,#b5f0cd);pointer-events:none;transition:transform 300ms cubic-bezier(.16,1,.3,1)}.ds-selector:has(#ds-host:checked)::before{transform:translateX(calc(100% + var(--switch-gap)))}.ds-selector:has(#ds-guest:checked)::before{transform:translateX(calc(200% + 2 * var(--switch-gap)))}.ds-selector label{position:relative;display:flex;align-items:center;justify-content:center;padding:10px 18px;border-radius:8px;font-size:13px;font-weight:600;color:var(--muted,#a3b3ac);cursor:pointer;min-height:42px}.ds-selector label:hover{color:var(--mint,#b5f0cd);background:#24372e}.ds-selector input:checked+label{color:var(--ink,#11261b);background:transparent}.ds-selector input:focus-visible+label{outline:2px solid var(--mint,#b5f0cd);outline-offset:3px}@media(max-width:700px){.ds-selector{width:100%;--switch-gap:2px}.ds-selector label{padding-inline:4px;font-size:12px;white-space:nowrap}}@media(prefers-reduced-motion:reduce){.ds-selector::before{transition:none}}"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "description": "A bordered rail of icon-and-text links with an Install accent, 44px targets, and visible keyboard focus.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#preview\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M3 9h18M7 6.5h.01M10 6.5h.01\"/></svg>Preview</a><a href=\"#how-it-works\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M10 7H7a5 5 0 0 0 0 10h3M14 7h3a5 5 0 0 1 0 10h-3M8 12h8\"/></svg>How it works</a><a class=\"ds-nav-install\" href=\"#install\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4v12m-5-5 5 5 5-5M5 20h14\"/></svg>Install</a></nav>",
      "css": ".ds-nav{font-family:Inter,'Segoe UI',sans-serif;display:flex;align-items:center;gap:4px;padding:5px;border:1px solid var(--line,#2b3935);border-radius:12px;background:var(--panel,#182321);font-size:14px;color:var(--text,#eef3f1)}.ds-nav a{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border-radius:8px;font-weight:600;color:inherit;text-decoration:none}.ds-nav a:hover{color:var(--mint,#b5f0cd);background:#24372e}.ds-nav svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;color:var(--mint,#b5f0cd)}.ds-nav .ds-nav-install{color:var(--mint,#b5f0cd);background:#223c2e}.ds-nav a:focus-visible{outline:2px solid var(--mint,#b5f0cd);outline-offset:5px}@media(max-width:700px){.ds-nav{order:3;width:100%;font-size:12px}.ds-nav a{flex:1;gap:6px;padding-inline:6px;white-space:nowrap}.ds-nav svg{width:16px;height:16px}}"
    },
    {
      "name": "GitHub repository button",
      "kind": "button",
      "description": "A bordered repository link shared by the header and footer, using the filled GitHub mark.",
      "html": "<a class=\"ds-github\" href=\"https://github.com/ThomasSerna/GhostPair\" aria-label=\"GhostPair repository on GitHub\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.769-.244.769-.542 0-.267-.01-1.155-.016-2.095-3.13.68-3.791-1.327-3.791-1.327-.512-1.3-1.249-1.645-1.249-1.645-1.021-.698.077-.684.077-.684 1.13.08 1.724 1.16 1.724 1.16 1.004 1.722 2.634 1.224 3.276.936.102-.728.393-1.225.715-1.507-2.499-.284-5.126-1.25-5.126-5.56 0-1.228.439-2.232 1.159-3.02-.117-.285-.503-1.428.11-2.978 0 0 .944-.302 3.094 1.153a10.787 10.787 0 0 1 5.632 0c2.148-1.455 3.09-1.153 3.09-1.153.615 1.55.23 2.693.113 2.978.722.788 1.158 1.792 1.158 3.02 0 4.322-2.631 5.273-5.138 5.552.404.35.766 1.034.766 2.084 0 1.506-.014 2.721-.014 3.09 0 .3.203.65.774.54A11.252 11.252 0 0 0 12 .75Z\"/></svg>GitHub</a>",
      "css": ".ds-github{font-family:Inter,'Segoe UI',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:10px 16px;border:1px solid var(--line,#2b3935);border-radius:9px;font-size:14px;font-weight:600;color:var(--text,#eef3f1);text-decoration:none}.ds-github:hover{color:var(--mint,#b5f0cd);background:var(--panel,#182321);border-color:var(--mint,#b5f0cd)}.ds-github svg{width:20px;height:20px;fill:currentColor;flex-shrink:0}.ds-github:focus-visible{outline:2px solid var(--mint,#b5f0cd);outline-offset:5px}@media(max-width:700px){.ds-github{padding-inline:12px;font-size:13px}}"
