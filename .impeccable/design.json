      "css": ".ds-nav{font-family:Inter,'Segoe UI',sans-serif;display:flex;align-items:center;gap:34px;font-size:14px;color:var(--muted,#a3b3ac)}.ds-nav a{color:inherit;text-decoration:none;padding-block:14px}.ds-nav a:hover{color:var(--mint,#b5f0cd)}.ds-nav a:focus-visible{outline:2px solid var(--mint,#b5f0cd);outline-offset:5px;border-radius:4px}@media(max-width:700px){.ds-nav{justify-content:space-between;gap:20px;font-size:13px}.ds-nav a{padding-block:6px}}"
