      "kind": "button",
      "refersTo": "button-install",
      "description": "Inverse action used on the mint installation field.",
      "html": "<a class=\"ds-install\" href=\"https://github.com/ThomasSerna/GhostPair/releases/latest\">Get the latest release <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4v12m-5-5 5 5 5-5M5 19h14\"/></svg></a>",
      "css": ".ds-install{display:inline-flex;align-items:center;justify-content:center;gap:20px;padding:16px 22px;border-radius:9px;font-size:14px;line-height:1.4;font-weight:600;text-decoration:none;font-family:Inter,'Segoe UI',sans-serif;background:var(--ink,#11261b);color:var(--mint,#b5f0cd)}.ds-install:hover{background:#244333;color:#eef3f1}.ds-install:focus-visible{outline:2px solid var(--ink,#11261b);outline-offset:5px}.ds-primary svg,.ds-install svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}@media(max-width:700px){.ds-install{padding:15px 18px;font-size:13px;gap:16px}}"
    },
    {
      "name": "Preview selector",
      "kind": "input",
      "refersTo": "preview-selector",
      "description": "A native fieldset and radios; the website uses CSS :has() to show each corresponding panel.",
      "html": "<fieldset class=\"ds-selector\"><legend class=\"ds-hidden\">Choose an interface example</legend><input class=\"ds-hidden\" type=\"radio\" name=\"ds-preview\" id=\"ds-shared\" checked><label for=\"ds-shared\">Shared view</label><input class=\"ds-hidden\" type=\"radio\" name=\"ds-preview\" id=\"ds-host\"><label for=\"ds-host\">Host a session</label><input class=\"ds-hidden\" type=\"radio\" name=\"ds-preview\" id=\"ds-guest\"><label for=\"ds-guest\">Join a session</label></fieldset>",
      "css": ".ds-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}.ds-selector{font-family:Inter,'Segoe UI',sans-serif;display:flex;gap:4px;position:relative;margin:0;padding:5px;border:1px solid var(--line,#2b3935);border-radius:12px;background:var(--panel,#182321)}.ds-selector label{display:flex;align-items:center;justify-content:center;padding:10px 18px;border-radius:8px;font-size:13px;color:var(--muted,#a3b3ac);cursor:pointer;min-height:42px}.ds-selector label:hover{color:var(--mint,#b5f0cd);background:#24372e}.ds-selector input:checked+label{color:var(--ink,#11261b);background:var(--mint,#b5f0cd);font-weight:600}.ds-selector input:focus-visible+label{outline:2px solid var(--mint,#b5f0cd);outline-offset:3px}@media(max-width:700px){.ds-selector{gap:2px}.ds-selector label{padding-inline:8px;flex:1;font-size:12px;white-space:nowrap}}"
    },
