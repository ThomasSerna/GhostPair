# Runtime values for a single Docker web service. Store DATABASE_URL as a secret.
HOST=0.0.0.0
PORT=8787
TRUST_PROXY=true
ALLOWED_ORIGINS=chrome-extension://replace_with_chrome_id,chrome-extension://replace_with_edge_id
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST/ghostpair
DATABASE_SSL_MODE=verify-full
# Optional absolute container path for a private database CA:
# DATABASE_SSL_CA_FILE=/run/secrets/database-ca.pem

# Public extension BUILD values, configured locally before package:store.
# Keep a stable custom domain to preserve identities on future host changes.
VITE_SIGNALING_URL=https://connect.YOUR_DOMAIN
VITE_STUN_URLS=stun:stun.l.google.com:19302
