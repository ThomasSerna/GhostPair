# Existing Render service: https://ghostpair.onrender.com
# Keep Auto-Deploy Off until a persistent PostgreSQL provider is configured.
# Runtime variables: set these in Render, not in extension build settings.
HOST=0.0.0.0
PORT=8787
NODE_ENV=production
TRUST_PROXY=true
# Replace locally/in Render with the provider connection URL; never commit it.
# An empty DATABASE_URL intentionally prevents startup until it is configured.
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
# Remove ssl* and uselibpqcompat query parameters from the provider URL.
# Do not override connection/query timeouts through URL parameters.
# For a private CA, mount a PEM file and set its absolute container path:
# DATABASE_SSL_CA_FILE=/etc/secrets/database-ca.pem

# Public extension BUILD settings. These contain no database credentials.
VITE_SIGNALING_URL=https://ghostpair.onrender.com
VITE_STUN_URLS=stun:stun.l.google.com:19302
