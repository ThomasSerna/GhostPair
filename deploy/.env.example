# Copy to root .env for a new deployment, or merge into the existing file.
# Set a real DNS name. Any valid Chrome/Edge extension ID can connect.
SIGNAL_DOMAIN=connect.example.com

# Public extension build defaults. Rebuild/reload after changing these.
# Reset existing manual settings with "Use build defaults".
VITE_SIGNALING_URL=https://connect.example.com
VITE_STUN_URLS=stun:connect.example.com:3478
