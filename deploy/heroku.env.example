# Heroku Cedar / heroku-26 signaling runtime example.
# Configure these as Heroku config vars. Never import this file with the blank URL.
# Heroku Postgres supplies DATABASE_URL; leave that managed value intact.
DATABASE_URL=
NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY=true
DATABASE_SSL_MODE=verify-full
# Heroku stack trust store includes the AWS RDS CA used by Essential Postgres.
DATABASE_SSL_CA_FILE=/usr/lib/ssl/certs/ca-certificates.crt
# PORT and DYNO are assigned by Heroku: do not configure them yourself.
# Do not set DATABASE_PATH or use SQLite on the ephemeral dyno filesystem.
# Do not add ssl* / uselibpqcompat or timeout overrides to DATABASE_URL.
# No VITE_* settings belong here: the extension builds its public defaults separately.
