{
  "name": "ghostpair",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "npm run build -w @ghostpair/protocol && npm run build -w @ghostpair/signaling && npm run build -w @ghostpair/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev:server": "npm run dev -w @ghostpair/signaling",
    "dev:extension": "npm run dev -w @ghostpair/extension",
    "package": "npm run build && node scripts/package.mjs",
    "test:browser": "node tests/browser/smoke.mjs",
    "test:frames": "node tests/browser/frame-probe.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fflate": "^0.8.2",
    "playwright": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
